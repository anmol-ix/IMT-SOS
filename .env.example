# Server-only runtime connection. The deployed app must use the restricted role.
DATABASE_URL=postgresql://itsmytoy_runtime:change-me@localhost:5432/itsmytoy

# Used only by the migration command/deployment job, never by the running app.
MIGRATION_DATABASE_URL=postgresql://itsmytoy_migrator:change-me@localhost:5432/itsmytoy

# One-time administrative role setup; never provide this value to the app service.
DATABASE_ADMIN_URL=postgresql://postgres:change-me@localhost:5432/itsmytoy
RUNTIME_DATABASE_ROLE=itsmytoy_runtime
RUNTIME_DATABASE_PASSWORD=replace-with-at-least-24-random-characters
MIGRATION_DATABASE_ROLE=itsmytoy_migrator
MIGRATION_DATABASE_PASSWORD=replace-with-at-least-24-random-characters

# WorkOS staging environment values.
WORKOS_API_KEY=sk_test_replace_me
WORKOS_CLIENT_ID=client_replace_me
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-random-characters
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Keep unset in production until the backup/restore safety gate is approved.
# Local development allows synthetic workbook validation without this flag.
WORKBOOK_VALIDATION_ENABLED=0

# Optional; defaults to 10.
DATABASE_POOL_MAX=10

# Railway first deployment only. Set to 1 together with the administrative
# values above, deploy once, then remove the admin URL and both standalone
# passwords and set this back to 0.
DEPLOY_BOOTSTRAP_DATABASE_ROLES=0

BUSINESS_NAME=ItsMyToy
