{
  "name": "itsmytoy-operations",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "node-pg-migrate up --migrations-dir db/migrations --database-url-var MIGRATION_DATABASE_URL",
    "deploy:check": "node scripts/validate-deployment-env.mjs",
    "deploy:prepare": "npm run deploy:check && node scripts/prepare-deployment.mjs",
    "db:roles": "node scripts/configure-database-roles.mjs",
    "db:seed-demo": "node scripts/seed-demo-products.mjs",
    "auth:create-setup-link": "node scripts/create-password-setup-link.mjs",
    "security:prove-operator-denial": "vitest run tests/integration/team-access.test.ts",
    "test:local-sale": "npm run test:integration",
    "test:local-operations": "npm run test:integration",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@zxing/browser": "0.1.5",
    "next": "^16.2.11",
    "node-pg-migrate": "^9.0.0",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "sass": "^1.102.0",
    "typescript": "latest",
    "vitest": "latest"
  }
}
