{
  "name": "itsmytoy-operations",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "node-pg-migrate up --migrations-dir db/migrations --database-url-var MIGRATION_DATABASE_URL",
    "db:roles": "node scripts/configure-database-roles.mjs",
    "db:provision-owner": "node scripts/provision-owner.mjs",
    "db:seed-demo": "node scripts/seed-demo-products.mjs",
    "security:prove-operator-denial": "node scripts/prove-operator-denial.mjs",
    "test:local-sale": "node scripts/prove-operator-denial.mjs",
    "test:local-operations": "node scripts/prove-operator-denial.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@workos-inc/authkit-nextjs": "latest",
    "@workos-inc/node": "latest",
    "@zxing/browser": "0.1.5",
    "next": "latest",
    "node-pg-migrate": "^9.0.0",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
